{
  "//": "appstatus.config — sample. Drop this file next to the host binary (or under RXNS_APPSTATUS_CONFIG_DIR). An optional appstatus.<RXNS_ENV>.config overlay layers on top, and appstatus.local.config (managed by the bubble's Settings tab) layers last.",

  "Targets": [
    { "Name": "myapp-dev",     "SubscriptionId": "00000000-0000-0000-0000-000000000000", "ResourceGroup": "myapp-dev",     "AppName": "myapp-dev",     "DefaultEnabled": true  },
    { "Name": "myapp-sit",     "SubscriptionId": "00000000-0000-0000-0000-000000000000", "ResourceGroup": "myapp-sit",     "AppName": "myapp-sit",     "DefaultEnabled": false },
    { "Name": "myapp-uat",     "SubscriptionId": "00000000-0000-0000-0000-000000000000", "ResourceGroup": "myapp-uat",     "AppName": "myapp-uat",     "DefaultEnabled": false },

    { "Name": "myapp-prod",    "SubscriptionId": "11111111-1111-1111-1111-111111111111", "ResourceGroup": "myapp-prod",    "AppName": "myapp-prod",    "DefaultEnabled": false }
  ],

  "//Ai": "Optional. The engine list starts empty: nothing is auto-registered. Engines come from one of: (a) env vars CLAUDE_API_KEY / OLLAMA_URL / FOUNDRY_URL set on the host, (b) entries you put under Ai.Engines[] here (full schema below), or (c) discovered by 'Scan LAN' in the bubble's Settings tab (those persist to appstatus.local.config, not this file). Do NOT add placeholder entries here — the picker should only show engines that actually exist."
}
