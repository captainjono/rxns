<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10 so this can reference Rxns.WebApiNET5, which is net10 and carries the
         SignalR hub. It also means the suite runs natively on an arm64 dev box, which has a
         net10 runtime and no net8 one - that needed DOTNET_ROLL_FORWARD to run at all. -->
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="5.10.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.7.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.1" />
    <PackageReference Include="coverlet.collector" Version="1.3.0" />
    <PackageReference Include="NSubstitute" Version="4.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Rxns\Rxns.csproj" />
    <ProjectReference Include="..\Rxns.WebApiNET5\Rxns.WebApiNET5.csproj" />
    <ProjectReference Include="..\src\Rxns.Redis\Rxns.Redis.csproj" />
  </ItemGroup>

</Project>
